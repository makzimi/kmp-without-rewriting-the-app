{
  "$schema": "https://schemas.dodo-engineering.theme/v1",
  "meta": {
    "name": "Dodo Engineering — Light",
    "source": "Шаблон Dodo Engineering (светлая).pptx",
    "theme_internal_name": "Simple Dark",
    "variant": "light",
    "extracted_at": "2026-05-19",
    "description": "Design tokens extracted from the Dodo Engineering presentation template. Use these to build web-based slides that match the original deck exactly."
  },
  "slide": {
    "aspect_ratio": "16:9",
    "size_inches": { "width": 10, "height": 5.625 },
    "size_px_base": { "width": 1280, "height": 720 },
    "size_px_alternatives": {
      "small":  { "width": 960,  "height": 540  },
      "medium": { "width": 1280, "height": 720  },
      "large":  { "width": 1600, "height": 900  },
      "fullhd": { "width": 1920, "height": 1080 }
    },
    "safe_area_padding": {
      "top": "5.3%",
      "right": "3%",
      "bottom": "5.3%",
      "left": "3%"
    },
    "grid": {
      "title_y_pct": 5.33,
      "title_height_pct": 11.2,
      "body_y_pct": 27.9,
      "body_height_pct": 66.5,
      "footer_y_pct": 92.0
    }
  },
  "color": {
    "background": {
      "primary": "#FFFFFF",
      "subtle": "#F5F5F5",
      "border_on_white": "#B8B8B8"
    },
    "text": {
      "primary": "#161616",
      "secondary": "#595959",
      "muted": "#808080",
      "disabled": "#B8B8B8",
      "on_accent": "#FFFFFF",
      "on_pastel": "#161616"
    },
    "accent_bright": {
      "purple": "#694BFB",
      "orange": "#FF5401",
      "orange_alt": "#FB5508",
      "mint": "#94E4CC",
      "yellow": "#FFE146",
      "blue": "#428EFF",
      "pink": "#FF81EF"
    },
    "accent_pastel": {
      "purple": "#B8B8FF",
      "peach":  "#FFC2A5",
      "mint":   "#D2FCEE",
      "yellow": "#FFF3B5",
      "pink":   "#FFCCF9"
    },
    "semantic": {
      "link":     "#428EFF",
      "link_hover": "#694BFB",
      "success":  "#94E4CC",
      "warning":  "#FFE146",
      "danger":   "#FF5401",
      "info":     "#428EFF"
    },
    "code": {
      "background": "#F5F5F5",
      "text":       "#161616",
      "comment":    "#808080",
      "keyword":    "#694BFB",
      "string":     "#FF5401",
      "number":     "#428EFF"
    }
  },
  "typography": {
    "font_family": {
      "display": "'Helvetica Neue', 'Helvetica', 'Arial', sans-serif",
      "display_light": "'Helvetica Neue Light', 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif",
      "body": "'Helvetica Neue Light', 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif",
      "body_strong": "'Helvetica Neue', 'Helvetica', 'Arial', sans-serif",
      "mono": "'Source Code Pro', 'SF Mono', 'Menlo', 'Consolas', monospace",
      "mono_semibold": "'Source Code Pro SemiBold', 'Source Code Pro', 'SF Mono', monospace",
      "decorative": "'Montserrat', 'Helvetica Neue', sans-serif"
    },
    "font_weight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "size_pt": {
      "cover_xl":   80,
      "cover_l":    60,
      "cover_m":    52,
      "section":    40,
      "h1":         32,
      "h2":         24,
      "h3":         20,
      "h4":         18,
      "h5":         16,
      "subtitle":   14,
      "body":       12,
      "small":      13,
      "caption":    10
    },
    "size_px_at_1280w": {
      "cover_xl":   107,
      "cover_l":    80,
      "cover_m":    69,
      "section":    53,
      "h1":         43,
      "h2":         32,
      "h3":         27,
      "h4":         24,
      "h5":         21,
      "subtitle":   19,
      "body":       16,
      "small":      17,
      "caption":    13
    },
    "line_height": {
      "tight": 1.0,
      "snug":  1.15,
      "normal": 1.35,
      "loose": 1.5
    },
    "letter_spacing": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.04em"
    },
    "roles": {
      "cover_title":      { "family": "display_light", "size_pt": 52, "weight": "light", "color": "text.primary", "line_height": "tight" },
      "section_title":    { "family": "display",       "size_pt": 32, "weight": "bold",  "color": "text.primary", "line_height": "snug" },
      "slide_title":      { "family": "display",       "size_pt": 14, "weight": "bold",  "color": "text.primary", "line_height": "snug" },
      "subtitle":         { "family": "body",          "size_pt": 14, "weight": "light", "color": "text.primary", "line_height": "normal" },
      "body":             { "family": "body",          "size_pt": 12, "weight": "light", "color": "text.primary", "line_height": "normal" },
      "body_strong":      { "family": "body_strong",   "size_pt": 12, "weight": "regular","color": "text.primary", "line_height": "normal" },
      "caption":          { "family": "body",          "size_pt": 10, "weight": "light", "color": "text.muted",   "line_height": "normal" },
      "footnote":         { "family": "body",          "size_pt": 10, "weight": "light", "color": "text.muted",   "line_height": "normal" },
      "code":             { "family": "mono",          "size_pt": 12, "weight": "regular","color": "code.text",   "line_height": "normal" },
      "code_heading":     { "family": "mono_semibold", "size_pt": 14, "weight": "semibold","color": "code.text",  "line_height": "snug" }
    }
  },
  "spacing": {
    "unit_px": 4,
    "scale": {
      "0":  0,
      "1":  4,
      "2":  8,
      "3":  12,
      "4":  16,
      "5":  20,
      "6":  24,
      "8":  32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80
    }
  },
  "radius": {
    "none": "0",
    "sm":   "4px",
    "md":   "8px",
    "lg":   "16px",
    "pill": "9999px"
  },
  "elevation": {
    "none": "none",
    "sm":   "0 1px 2px rgba(22,22,22,0.06)",
    "md":   "0 2px 8px rgba(22,22,22,0.08)",
    "lg":   "0 6px 24px rgba(22,22,22,0.10)"
  },
  "stroke": {
    "thin":   "1px",
    "medium": "2px",
    "thick":  "4px"
  },
  "fonts_to_load": {
    "google_fonts": [
      "https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;600&family=Montserrat:wght@500&display=swap"
    ],
    "system_fonts": ["Helvetica Neue", "Helvetica", "Arial"],
    "embedded_in_pptx": [
      "Helvetica Neue (regular/italic/bold/boldItalic)",
      "Helvetica Neue Light (regular/italic/bold/boldItalic)",
      "Montserrat Medium (regular/italic/bold/boldItalic)",
      "Source Code Pro (regular/italic/bold/boldItalic)",
      "Source Code Pro SemiBold (regular/italic/bold/boldItalic)"
    ]
  }
}
